# Backend Environment Configuration
# Copy this file to .env and update values for your environment

# Server
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2026
JWT_EXPIRY=12h

# CORS Configuration
FRONTEND_URL=http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3000

# Database (optional for future PostgreSQL migration)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sightpulse_db
# DB_USER=postgres
# DB_PASSWORD=your-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10mb

# Logging
LOG_LEVEL=info
